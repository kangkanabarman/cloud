# ==============================================================================
# MediCloud — Environment Configuration Example (.env.example)
# ACADEMIC PROTOTYPE & AWS CLOUD COMPUTING FT-III CASE STUDY
# NOTE: Replace placeholder values with environment-specific secrets.
# NEVER commit the real .env file into version control.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
APP_NAME=MediCloud-HMS
BASE_URL=http://localhost:3000

# Session & Security Secret (Generate a strong random string in production)
SESSION_SECRET=placeholder_session_secret_change_in_production_min_32_chars
SESSION_MAX_AGE_MS=86400000

# Local Database Configuration (Initial Prototype)
DATABASE_TYPE=sqlite
DATABASE_PATH=./database/medicloud.sqlite
BACKUP_DIRECTORY=./data/backups

# Target Production Database (Amazon RDS for MySQL - Proposed Cloud Architecture)
# RDS_DB_HOST=medicloud-mysql-cluster.c7xyz.us-east-1.rds.amazonaws.com
# RDS_DB_PORT=3306
# RDS_DB_NAME=medicloud_db
# RDS_DB_USER=medicloud_app_user
# RDS_DB_PASSWORD=placeholder_rds_app_password
# RDS_DB_SSL=true

# Target AWS S3 Configuration (Encrypted Attachment Storage - Proposed)
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=medicloud-clinical-records-encrypted-demo
# S3_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/placeholder-kms-id

# Target AWS CloudWatch & CloudTrail (Proposed Monitoring)
# CLOUDWATCH_LOG_GROUP=/aws/elasticbeanstalk/medicloud/application.log
# CLOUDWATCH_METRIC_NAMESPACE=MediCloud/Production

# Rate Limiting & Audit Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
