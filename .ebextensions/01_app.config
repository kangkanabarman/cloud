# ==============================================================================
# AWS Elastic Beanstalk Configuration (.ebextensions)
# Node.js Platform Configuration for MediCloud
# ==============================================================================

option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080
    APP_NAME: "MediCloud-HMS-Production"
  aws:elasticbeanstalk:container:nodejs:
    NodeVersion: 22.x
    ProxyServer: nginx
  aws:elbv2:listener:443:
    Protocol: HTTPS
    SSLCertificateArns: arn:aws:acm:us-east-1:123456789012:certificate/placeholder-cert-arn
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/health
    Port: 8080
    Protocol: HTTP
    MatcherHTTPCode: "200"
